{
  "name": "obsidian-format-with-prettier-el",
  "version": "1.0.0",
  "description": "Format vault files using Prettier.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run check-format && npm run lint && npm run test && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json && npm i",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,js,css}\" styles.css --config .prettierrc",
    "check-format": "prettier --check \"src/**/*.{ts,js,css}\" styles.css --config .prettierrc",
    "test": "vitest run",
    "update": "npm update && npm ci && npm i",
    "upgrade": "npx npm-check-updates -u && npm i"
  },
  "keywords": [
    "Obsidian plugin",
    "Obsidian",
    "regex"
  ],
  "license": "MIT",
  "dependencies": {
    "builtin-modules": "^5.3.0",
    "common-tags": "^1.8.2",
    "obsidian": "1.13.1",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/common-tags": "^1.8.4",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "prettier-plugin-css-order": "^2.2.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
{
  "name": "obsidian-format-with-prettier-el",
  "version": "1.0.1",
  "description": "Format vault files using Prettier.",
  "main": "main.js",
  "scripts": {
    "validate": "npm run check-format && npm run lint && npm run test",
    "dev": "npm run validate && node esbuild.config.mjs",
    "build": "npm run validate && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json && npm i",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,js,css}\" styles.css --config .prettierrc",
    "check-format": "prettier --check \"src/**/*.{ts,js,css}\" styles.css --config .prettierrc",
    "test": "vitest run",
    "update": "npm update && npm ci && npm i",
    "upgrade": "npx npm-check-updates -u && npm i"
  },
  "keywords": [
    "Obsidian plugin",
    "Obsidian",
    "regex"
  ],
  "license": "MIT",
  "dependencies": {
    "builtin-modules": "^5.4.0",
    "ignore": "^7.0.12",
    "prettier": "^3.9.9",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/common-tags": "^1.8.4",
    "@types/node": "^26.6.4",
    "common-tags": "^1.8.2",
    "esbuild": "^0.28.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.13.1",
    "prettier-plugin-css-order": "^2.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}